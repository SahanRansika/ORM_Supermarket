    "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
  <session-factory>
    <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
    <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/hibernate_gdse_71?createDatabaseIfNotExist=true</property>
    <property name="hibernate.connection.username">root</property> <!--username-->
    <property name="hibernate.connection.password">Ijse@1234</property><!--password-->

    <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
